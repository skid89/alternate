# Alternate - Environment Variables Configuration

# ----------------------------
# Database Settings
# ----------------------------
# PostgreSQL database url (from Supabase, Railway, Neon, or local instance)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alternate?schema=public"

# ----------------------------
# Authentication Settings
# ----------------------------
# Secret key used to encrypt/decrypt session JWT tokens (generate a long random string)
JWT_SECRET="super-secret-random-jwt-signing-key-change-in-production-123456"

# ----------------------------
# Application Settings
# ----------------------------
# Root URL of the application (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secure setup secret required to initialize the first admin account at /admin/setup
# Once the first admin is created, this route is permanently disabled.
ADMIN_SETUP_SECRET="alternate-admin-initialize-token-2026-secure"

# ----------------------------
# Discord OAuth & Presence Integration
# ----------------------------
# Required to support Discord login / profile linking and active status widgets
DISCORD_CLIENT_ID="your-discord-client-id"
DISCORD_CLIENT_SECRET="your-discord-client-secret"
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/callback/discord"

# ----------------------------
# Google OAuth Integration (Optional)
# ----------------------------
# Optional secondary authentication method
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# ----------------------------
# Media & Storage Settings
# ----------------------------
# Object storage keys. Set to "local" to store files inside public/uploads (development only)
# For production, configure Supabase Storage or an S3 compatible provider.
STORAGE_PROVIDER="local"

# If STORAGE_PROVIDER="supabase"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_BUCKET_NAME="alternate-media"

# If STORAGE_PROVIDER="s3"
# AWS_ACCESS_KEY_ID="your-aws-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# AWS_REGION="us-east-1"
# S3_BUCKET_NAME="alternate-media"
